DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
BETTER_AUTH_SECRET="generate-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="Hafi <no-reply@your-verified-domain.com>"

# Cloudinary media storage (required to store new place photos and banner media outside PostgreSQL)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Upstash Redis rate limiting (protects authentication, search, uploads, and write APIs in production)
UPSTASH_REDIS_REST_URL="https://your-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token"

# Use a production tile provider URL at scale. Keep the OpenStreetMap default for local development.
NEXT_PUBLIC_MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
